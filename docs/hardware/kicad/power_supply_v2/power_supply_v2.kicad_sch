	(text "V_{out} = 0.596 * (1 + R15 / (R16 + R17) + R15 / R18) - V_{DAC} * (R15 / R18)\n\nV_{DAC} = 0 to 3V3\nR15 / (R16 + R17) = 26R53\nR15 / R18 = 4R55\n\nWhen V_{DAC} = 0, V_{OUT} = 19V12\nWhen V_{DAC} = 3V3, V_{OUT} = 4V1"
		(exclude_from_sim no)
